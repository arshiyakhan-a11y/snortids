# Snort 3.12.2.0 Compatible Local Rules
# NO threshold, NO nocase - only Snort 3 native keywords

alert icmp any any -> any any (
    msg:"ICMP Ping Detected";
    sid:1000001; rev:1;
    classtype:icmp-event; priority:3;
)

alert icmp any any -> any any (
    msg:"ICMP Flood Detected";
    detection_filter:track by_src, count 10, seconds 5;
    sid:1000002; rev:1;
    classtype:attempted-dos; priority:2;
)

alert tcp any any -> any any (
    msg:"TCP SYN Flood Detected";
    flags:S;
    detection_filter:track by_dst, count 20, seconds 5;
    sid:1000003; rev:1;
    classtype:attempted-dos; priority:1;
)

alert tcp any any -> any any (
    msg:"Possible Port Scan Detected";
    flags:S;
    detection_filter:track by_src, count 15, seconds 10;
    sid:1000004; rev:1;
    classtype:attempted-recon; priority:2;
)

alert tcp any any -> any 21 (
    msg:"FTP Connection Detected";
    sid:1000005; rev:1;
    classtype:policy-violation; priority:3;
)

alert tcp any any -> any 22 (
    msg:"SSH Connection Detected";
    sid:1000006; rev:1;
    classtype:policy-violation; priority:3;
)

alert tcp any any -> any 23 (
    msg:"Telnet Connection Detected";
    sid:1000007; rev:1;
    classtype:policy-violation; priority:3;
)

alert tcp any any -> any 80 (
    msg:"HTTP Traffic Detected";
    sid:1000008; rev:1;
    classtype:policy-violation; priority:3;
)

alert udp any any -> any 53 (
    msg:"DNS Query Detected";
    sid:1000009; rev:1;
    classtype:policy-violation; priority:3;
)

alert tcp any any -> any 445 (
    msg:"SMB Traffic Detected";
    sid:1000010; rev:1;
    classtype:policy-violation; priority:3;
)

alert tcp any any -> any [80,8080,443] (
    msg:"Web Traffic Detected";
    sid:1000011; rev:1;
    classtype:policy-violation; priority:3;
)

alert tcp any any -> any 4444 (
    msg:"Connection to Meterpreter Default Port";
    sid:1000012; rev:1;
    classtype:trojan-activity; priority:1;
)

alert udp any any -> any any (
    msg:"UDP Traffic Detected";
    sid:1000013; rev:1;
    classtype:policy-violation; priority:3;
)

alert tcp any any -> any 3389 (
    msg:"RDP Connection Detected";
    sid:1000014; rev:1;
    classtype:policy-violation; priority:3;
)

alert tcp any any -> any 3306 (
    msg:"MySQL Connection Detected";
    sid:1000015; rev:1;
    classtype:policy-violation; priority:3;
)

alert tcp any any -> any 5432 (
    msg:"PostgreSQL Connection Detected";
    sid:1000016; rev:1;
    classtype:policy-violation; priority:3;
)

alert tcp any any -> any 6379 (
    msg:"Redis Connection Detected";
    sid:1000017; rev:1;
    classtype:policy-violation; priority:3;
)

alert tcp any any -> any 27017 (
    msg:"MongoDB Connection Detected";
    sid:1000018; rev:1;
    classtype:policy-violation; priority:3;
)

alert tcp any any -> any 9200 (
    msg:"Elasticsearch Connection Detected";
    sid:1000019; rev:1;
    classtype:policy-violation; priority:3;
)

alert ip any any -> any any (
    msg:"Suspicious Large Packet Detected";
    dsize:>10000;
    sid:1000020; rev:1;
    classtype:bad-unknown; priority:2;
)
